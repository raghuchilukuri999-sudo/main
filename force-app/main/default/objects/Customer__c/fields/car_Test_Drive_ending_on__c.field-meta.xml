<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>car_Test_Drive_ending_on__c</fullName>
    <formula>IF(
    AND(
        NOT(ISBLANK(car_Test_Drive_Start_Date_On__c)),
        NOT(ISBLANK(Number_of_Test_Drive_Days__c))
    ),
    car_Test_Drive_Start_Date_On__c + Number_of_Test_Drive_Days__c,
    NULL
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>car Test Drive ending on</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
