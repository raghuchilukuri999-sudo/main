<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>salary_incremented</fullName>
    <active>true</active>
    <errorConditionFormula>ABS( salary_increment_in_numbers_this_month__c )  &lt; 2000</errorConditionFormula>
    <errorDisplayField>salary_increment_in_numbers_this_month__c</errorDisplayField>
    <errorMessage>salary should be at least 2000+ incremented this time</errorMessage>
</ValidationRule>
